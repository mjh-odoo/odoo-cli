# Created once by: odoo init (or node scripts/dev.mjs init). Existing .env is kept.
# Keep project identity and host ports blank; init allocates them per directory.
PROJECT_NAME=
ENV=DEV
DB_PORT=
ODOO_HTTP_PORT=
ODOO_GEVENT_PORT=
DB_BIND_ADDRESS=127.0.0.1
ODOO_BIND_ADDRESS=127.0.0.1
PGDATABASE=odoo
PGUSER=odoo
# Passwords: non-empty template values are kept; blank values are generated.
# Only shared development defaults belong in this tracked template.
PGPASSWORD=
ODOO_MASTER_PASSWORD=
ODOO_ADMIN_LOGIN=admin
ODOO_ADMIN_PASSWORD=
ODOO_INIT_MODULES=base,web
ODOO_ADDONS_PATH=addons/custom,addons/third-party,addons/nonprod
# Empty values use ENV defaults.
ODOO_WORKERS=
ODOO_MAX_CRON_THREADS=
ODOO_DEV_MODE=
ODOO_LIST_DB=
ODOO_DBFILTER=
ODOO_PROXY_MODE=False
ODOO_LOG_LEVEL=info
ODOO_WITH_DEMO=False
APT_MIRROR_BASE=https://deb.debian.org
