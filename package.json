{
  "name": "@mjh-odoo/cli",
  "version": "0.1.1",
  "description": "Cross-platform Odoo development CLI: environments, modules, database archives, logs and images",
  "type": "module",
  "bin": {
    "odoo": "bin/odoo.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "LGPL-3.0-only",
  "author": "MaJianhang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjh-odoo/odoo-cli.git"
  },
  "homepage": "https://github.com/mjh-odoo/odoo-cli#readme",
  "bugs": {
    "url": "https://github.com/mjh-odoo/odoo-cli/issues"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "LICENSE",
    "COPYRIGHT"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check bin/odoo.mjs && node --check src/cli.mjs && node --check src/commands.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "commander": "15.0.0"
  }
}
